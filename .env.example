# Copy to .env and fill in. The key must belong to the organization you want to report on
# and carry the Organization Owner role (required by the Billing endpoints).
CAPELLA_API_KEY=
# Optional overrides
CAPELLA_BASE_URL=https://cloudapi.cloud.couchbase.com
# CAPELLA_ORG_ID=            # discovered automatically from the key when empty
CAPELLA_MOCK=false           # true = serve bundled fixtures, never call Capella
SYNC_BACKFILL_DAYS=90
SYNC_REFRESH_DAYS=7
SYNC_ON_START=true
SYNC_INTERVAL_MINUTES=360
RATE_LIMIT_PER_MINUTE=80
# Host ports (change if another stack already uses them)
UI_PORT=5173
API_PORT=8000
